#!/usr/bin/env bash
# Start the claude-collector via docker compose.
# Requires HONEYCOMB_API_KEY to be set in the environment.
# Optional: HONEYCOMB_API_ENDPOINT (default api.honeycomb.io:443 for US ingest).

set -euo pipefail

cd "$(dirname "$0")"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

if [[ -z "${HONEYCOMB_API_KEY:-}" ]]; then
  echo "error: HONEYCOMB_API_KEY is not set." >&2
  echo "       copy .env.example to .env and fill in your key, or export it in your shell." >&2
  exit 1
fi

echo "Starting collector..."
echo "  OTLP gRPC: localhost:4327"
echo "  OTLP HTTP: localhost:4328"
echo "  Exporting to: ${HONEYCOMB_API_ENDPOINT:-api.honeycomb.io:443}"
echo "  Archiving traces to: s3://${S3_BUCKET:-devrel-takeout-telemetry-dev-6a8ca705}/${S3_PREFIX:-claude-code}/"
echo

exec docker compose up
