# Copy this file to `.env` and fill in your values.
# `./run` will source `.env` automatically, and `docker compose` also picks it up.

# Required: ingest key for the Honeycomb environment you want the data to land in.
HONEYCOMB_API_KEY=

# Optional: default is US ingest. Set to api.eu1.honeycomb.io:443 if you're on EU.
# HONEYCOMB_API_ENDPOINT=api.honeycomb.io:443

# S3 archive of raw traces for takeout-telemetry. Run
# scripts/create-s3-supplier-user.sh to create the IAM user and fill these in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=devrel-takeout-telemetry-dev-6a8ca705
S3_PREFIX=claude-code
